<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>JeevaMitra</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>jeevamitra</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Required by FirebaseAuth/PhoneAuthProvider.swift's verifyPhoneNumber()
				     (guard at line 108-109 of the pinned firebase-ios-sdk 11.15.0 source):
				     it force-reads Info.plist's CFBundleURLTypes via an implicitly-unwrapped
				     optional (Auth.swift mainBundleUrlTypes, set from
				     Bundle.main.object(forInfoDictionaryKey: "CFBundleURLTypes") in Auth.init).
				     With this key absent, that read is nil and the guard's argument
				     evaluation traps with "Unexpectedly found nil while implicitly
				     unwrapping an Optional value" before any verifyPhoneNumber callback
				     can fire. The scheme below is the exact fallback PhoneAuthProvider
				     computes when no Google Sign-In clientID is configured (this project's
				     firebase_options.dart ios options set no iosClientId): "app-" followed
				     by the iOS GOOGLE_APP_ID with ":" replaced by "-"
				     (1:360739375700:ios:a5e1ec8834b178621b3bc1). -->
				<string>app-1-360739375700-ios-fa1f43f7a6d2a5101b3bc1</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>JeevaMitra uses your location to show nearby grazing land, vets, and disease alerts, and to pin your land's location when you list it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>JeevaMitra uses the microphone for the voice assistant so you can navigate the app by speaking.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>JeevaMitra needs access to your photos so you can add pictures of your land when listing it.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
